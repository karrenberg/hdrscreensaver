#include <windows.h>

#define IDD_SETTINGS     2000
#define IDC_FOLDER_EDIT 2001
#define IDC_BROWSE_BTN  2002
#define IDC_DISPLAYSEC_EDIT 2003
#define IDC_LOG_ENABLE   2004
#define IDC_LOGPATH_EDIT 2005
#define IDC_LOGPATH_BROWSE 2006
#define IDC_INCLUDE_SUBFOLDERS 2007
#define IDC_RANDOMIZE_ORDER 2008
#define IDC_MAP_OVERLAY 2009
#define IDC_MAP_ZOOM_SLIDER 2010
#define IDC_MAP_ZOOM_LABEL 2011
#define IDC_DATE_OVERLAY 2012

IDD_SETTINGS DIALOGEX 0, 0, 320, 200
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "HDRScreenSaver Settings"
FONT 9, "Segoe UI", 0, 0, 0x1
BEGIN
    LTEXT       "Image folder:", -1, 10, 10, 60, 10
    EDITTEXT    IDC_FOLDER_EDIT, 75, 8, 170, 14, ES_AUTOHSCROLL
    PUSHBUTTON  "Browse...", IDC_BROWSE_BTN, 250, 7, 60, 16
    LTEXT       "Display seconds:", -1, 10, 35, 80, 10
    EDITTEXT    IDC_DISPLAYSEC_EDIT, 100, 33, 40, 14, ES_NUMBER
    AUTOCHECKBOX "Include subfolders", IDC_INCLUDE_SUBFOLDERS, 10, 60, 80, 12
    AUTOCHECKBOX "Show photo date", IDC_DATE_OVERLAY, 130, 60, 150, 12
    AUTOCHECKBOX "Randomize order", IDC_RANDOMIZE_ORDER, 10, 80, 100, 12
    AUTOCHECKBOX "Show location map (M)", IDC_MAP_OVERLAY, 130, 80, 150, 12
    LTEXT       "Map zoom:", -1, 10, 100, 50, 10
    CONTROL     "", IDC_MAP_ZOOM_SLIDER, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 60, 97, 160, 18
    LTEXT       "", IDC_MAP_ZOOM_LABEL, 225, 100, 85, 10
    LTEXT       "Enable logging:", -1, 10, 125, 80, 10
    AUTOCHECKBOX "Log to file", IDC_LOG_ENABLE, 100, 123, 60, 12
    LTEXT       "Log file path:", -1, 10, 145, 80, 10
    EDITTEXT    IDC_LOGPATH_EDIT, 100, 143, 150, 14, ES_AUTOHSCROLL
    PUSHBUTTON  "Browse...", IDC_LOGPATH_BROWSE, 260, 142, 50, 16
    DEFPUSHBUTTON "OK", IDOK, 170, 165, 60, 16
    PUSHBUTTON  "Cancel", IDCANCEL, 240, 165, 60, 16
END
